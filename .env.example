# Copy this file to `.env` and fill in your key. Never commit `.env`.
OPENAI_API_KEY=sk-...

# Optional: override the default model (default is gpt-5-mini)
# MINIDEV_MODEL=gpt-5

# Optional: point mini-dev at any OpenAI-compatible backend.
#   DeepSeek:   https://api.deepseek.com       (model: 用支持 function calling 的 chat 模型，ID 见官方文档)
#   OpenRouter: https://openrouter.ai/api/v1    (model: e.g. openai/gpt-5-mini)
#   OpenAI (default): leave unset
# OPENAI_BASE_URL=https://api.deepseek.com
